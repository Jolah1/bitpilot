# ─── Rust ─────────────────────────────────────────────────────────────────────
target/
**/*.rs.bk
Cargo.lock          # remove this line if you want to pin deps in a library

# ─── ldk-node data (never commit private keys!) ──────────────────────────────
ldk-data/
ldk_data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# ─── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
*.local

# ─── Environment variables (NEVER commit secrets) ────────────────────────────
.env
.env.local
.env.*.local
.env.production

# ─── Editor / OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Test artefacts ───────────────────────────────────────────────────────────
coverage/
lcov.info

# ─── CI caches ────────────────────────────────────────────────────────────────
.cache/
.cargo/registry/   # only if not using a shared Cargo home