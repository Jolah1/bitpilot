#!/usr/bin/env bash
# Pre-push hook: scan every commit being pushed for secrets. This is the
# safety net that catches commits which bypassed pre-commit (amends, rebases,
# cherry-picks, or `git commit --no-verify`).
#
# Install once per clone:
#   ./scripts/install-hooks.sh
#
# Bypass in genuine emergencies (and only if you really understand the risk):
#   git push --no-verify
#
# Requires gitleaks on PATH. Install: https://github.com/gitleaks/gitleaks
#
# Protocol: git passes refs being pushed on stdin, one per line:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# We scan the commit range (remote_sha..local_sha) for each ref. For brand-new
# branches (remote_sha is all zeros), we scan from the merge-base with the
# remote's default branch instead of the entire history, to keep this fast.

set -euo pipefail

# Git hooks inherit a stripped-down PATH that often misses user-local bin
# directories. Augment PATH with the common install targets so the hook
# works even when the user's interactive shell exports them via .bashrc
# (which doesn't get sourced by git).
export PATH="$HOME/.local/bin:$HOME/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v gitleaks >/dev/null 2>&1; then
    cat >&2 <<'EOF'
[pre-push] gitleaks not found. Refusing to push.

Searched: $HOME/.local/bin, $HOME/bin, /opt/homebrew/bin, /usr/local/bin, and $PATH.

Install it before pushing:
  Linux x86_64:
    mkdir -p ~/.local/bin
    curl -sSL https://github.com/gitleaks/gitleaks/releases/download/v8.21.2/gitleaks_8.21.2_linux_x64.tar.gz \
      | tar -xz -C ~/.local/bin gitleaks
    chmod +x ~/.local/bin/gitleaks
  macOS:
    brew install gitleaks

Or skip this push (NOT recommended) with: git push --no-verify
EOF
    exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
config="$repo_root/.gitleaks.toml"
zero="0000000000000000000000000000000000000000"

# Track whether anything failed across all refs being pushed.
failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Deleting a remote branch — nothing to scan.
    if [[ "$local_sha" == "$zero" ]]; then
        continue
    fi

    if [[ "$remote_sha" == "$zero" ]]; then
        # New branch on the remote. Scan from the merge-base with origin/HEAD
        # (typically origin/main) so we don't re-scan history that's already
        # been pushed. If origin/HEAD isn't resolvable, scan the whole branch.
        if base="$(git merge-base "$local_sha" origin/HEAD 2>/dev/null)"; then
            range="${base}..${local_sha}"
        else
            range="$local_sha"
        fi
    else
        range="${remote_sha}..${local_sha}"
    fi

    echo "[pre-push] scanning $range for secrets..."
    if ! gitleaks git --redact --no-banner --config "$config" \
            --log-opts="$range" "$repo_root"; then
        echo "[pre-push] secrets detected in $local_ref. Push blocked." >&2
        failed=1
    fi
done

if (( failed != 0 )); then
    cat >&2 <<'EOF'

One or more commits being pushed contain what look like secrets.
The values above are redacted; check the commit SHA + file path shown.

If it's a false positive, add the pattern to .gitleaks.toml [allowlist].
If it's a real secret:
  1. Rotate the credential at its source NOW (assume it's already public).
  2. Rewrite history to remove it (git filter-repo, bfg-repo-cleaner, or
     interactive rebase) before pushing.
  3. Do NOT just amend and force-push without rotation — the secret will
     still exist in any local clone, your reflog, and any fork.
EOF
    exit 1
fi
