#!/usr/bin/env bash
# Pre-commit hook: refuse to commit if gitleaks detects a secret in the staged
# diff. Lives in the repo (scripts/pre-commit) so it survives `git clone`; the
# matching .git/hooks/pre-commit just execs this file.
#
# Install once per clone:
#   ./scripts/install-hooks.sh
#
# Bypass in genuine emergencies (and only if you understand the risk):
#   git commit --no-verify
#
# Requires gitleaks installed. Install: https://github.com/gitleaks/gitleaks

set -euo pipefail

# Git hooks inherit a stripped-down PATH that often misses user-local bin
# directories. Augment PATH with the common install targets so the hook
# works even when the user's interactive shell exports them via .bashrc
# (which doesn't get sourced by git).
export PATH="$HOME/.local/bin:$HOME/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v gitleaks >/dev/null 2>&1; then
    cat >&2 <<'EOF'
[pre-commit] gitleaks not found.

Searched: $HOME/.local/bin, $HOME/bin, /opt/homebrew/bin, /usr/local/bin, and $PATH.

Install it before committing:
  Linux x86_64:
    mkdir -p ~/.local/bin
    curl -sSL https://github.com/gitleaks/gitleaks/releases/download/v8.21.2/gitleaks_8.21.2_linux_x64.tar.gz \
      | tar -xz -C ~/.local/bin gitleaks
    chmod +x ~/.local/bin/gitleaks
  macOS:
    brew install gitleaks

If gitleaks is installed somewhere else, either symlink it into one of the
searched directories or add its parent to your shell's PATH (and re-run
./scripts/install-hooks.sh).

Or skip this commit (NOT recommended) with: git commit --no-verify
EOF
    exit 1
fi

# `gitleaks git --staged` scans only what's about to be committed (gitleaks v8+).
# --redact replaces secret values in output so they never echo to the terminal.
# --no-banner keeps the commit output tight on success.
gitleaks git --staged --redact --no-banner \
    --config "$(git rev-parse --show-toplevel)/.gitleaks.toml"
