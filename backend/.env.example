# BitPilot backend — environment variables.
#
# Copy this file to `.env` (which is gitignored) and fill in real values for
# anything you want to override. Every variable here has a working default so
# the backend boots with an empty `.env` for local development.
#
# NEVER commit the real `.env`. The pre-commit and pre-push hooks under
# scripts/ run gitleaks and will block accidental commits, but the only
# guarantee is "don't put real secrets in tracked files in the first place."

# ── Runtime ──────────────────────────────────────────────────────────────────

# Port the HTTP server binds to. Default: 8080.
# PORT=8080

# tracing-subscriber filter. Default: bitpilot=info,tower_http=info.
# tower_http=info is required for the per-request completion line (the
# "status=… latency=…" you grep for in prod). Drop to warn for quiet dev.
# NEVER set this to trace/debug for tower_http or sqlx in production —
# request bodies and SQL parameters will end up in your log aggregator.
# RUST_LOG=bitpilot=info,tower_http=info

# Log output format. Default: text (pretty, human-readable).
# Set to "json" in production so log shippers (Logflare, Better Stack,
# Datadog) can parse fields. Every request gets a uuid v4 request_id
# attached to its span and echoed on the x-request-id response header,
# so a customer complaint maps to a row in the aggregator.
# LOG_FORMAT=json

# ── Database ─────────────────────────────────────────────────────────────────

# SQLite database URL. Default: sqlite://bitpilot.db?mode=rwc (file created
# if missing, in the backend's working directory).
#
# Production: point at a path on a persistent volume that is *not* world-
# readable. The DB stores SHA-256 hashes of bearer tokens (not the plaintext
# — see migration 0004), Nostr public keys (npubs only; nsecs stay in the
# learner's browser), and proof artifacts. A leaked DB no longer lets an
# attacker impersonate a learner or facilitator, but the proof ledger
# (lightning_log, nostr_log) is still sensitive — treat the file with care.
# Backup/restore procedure: see docs/BACKUP.md.
#
# Examples:
#   DATABASE_URL=sqlite:///var/lib/bitpilot/bitpilot.db?mode=rwc
#   DATABASE_URL=sqlite:///mnt/data/bitpilot.db?mode=rwc
# DATABASE_URL=sqlite://bitpilot.db?mode=rwc

# ── Security ─────────────────────────────────────────────────────────────────

# Comma-separated list of origins allowed to make cross-origin requests.
# Default: http://localhost:5173 (the Vite dev server).
# Production: set to your real frontend URL(s). Do NOT include trailing slashes.
# Example:
#   CORS_ALLOWED_ORIGINS=https://bitpilot.example.com,https://staging.bitpilot.example.com
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Maximum request body size in bytes. Default: 65536 (64 KB).
# Bigger requests are rejected with 413 Payload Too Large.
# BODY_LIMIT_BYTES=65536

# Maximum per-request wall-clock time in seconds. Default: 25.
# REQUEST_TIMEOUT_SECS=25

# Rate limiting (per remote IP, token-bucket via tower_governor).
# RATE_LIMIT_PER_SEC: long-term sustained refill rate. Default: 1.
# RATE_LIMIT_BURST:   burst capacity. Default: 30.
#
# CLASSROOM NOTE: when ~15+ learners share one NAT (typical school wifi),
# the per-IP bucket trips fast. Bump these in production:
#   RATE_LIMIT_PER_SEC=5
#   RATE_LIMIT_BURST=120
# The defaults below stay friendly for single-user dev work.
# RATE_LIMIT_PER_SEC=1
# RATE_LIMIT_BURST=30

# Master facilitator key. OPTIONAL. If set, anyone with this key can access
# any session's admin endpoints by sending it in the X-Facilitator-Key header.
# Per-session facilitator tokens (returned from POST /api/sessions) work
# even when this is unset, and should be your default.
# FACILITATOR_KEY=replace-me-with-a-long-random-string

# ── Nostr ────────────────────────────────────────────────────────────────────

# Comma-separated wss:// relay URLs. Default uses three public relays:
# relay.damus.io, nos.lol, relay.nostr.band.
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band

# ── Cashu eCash ──────────────────────────────────────────────────────────────

# Cashu mint URL. Default: https://testnut.cashu.space — a public *test* mint
# whose Lightning invoices are auto-marked paid. Real Cashu V4 tokens that any
# wallet (Minibits, Nutshell, eNuts) can read. Do NOT point at a mainnet mint
# without explicit intent — there is no "test mode" check at the API layer.
# CASHU_MINT_URL=https://testnut.cashu.space

# ── Lightning (LNbits, signet/testnet) ───────────────────────────────────────

# To enable REAL Lightning, point at an LNbits wallet:
#   1. Open https://legend.lnbits.com (auto-creates a signet wallet on first
#      visit; bookmark the URL or you'll lose it).
#   2. Click your wallet name → "API info".
#   3. Copy the URL and the "Admin key" below.
#
# When BOTH are set, /api/invoice creates real BOLT11s. /api/pay remains
# simulated until you ALSO set LIGHTNING_REAL_ALLOW_PAYOUTS=1 (see below).
# When EITHER LNBITS_URL or LNBITS_ADMIN_KEY is blank, Lightning stays
# fully simulated and the UI shows a "Simulated" badge.
#
# Admin key has full wallet control — treat as a password, never commit.
# Invoice-only key is safer if you only need to issue invoices.
# LNBITS_URL=https://legend.lnbits.com
# LNBITS_ADMIN_KEY=
# LNBITS_INVOICE_KEY=

# ── Real-payout safeguards ───────────────────────────────────────────────────
#
# Double-opt-in for real payouts. LNbits creds being present is necessary
# but not sufficient — you must ALSO set this to "1" before /api/pay moves
# real sats. Lets you run real invoices in staging without exposing the
# wallet to real payouts from misconfigured caller code.
# LIGHTNING_REAL_ALLOW_PAYOUTS=1

# Per-call payment ceiling in sats. /api/pay rejects (403) any invoice
# whose decoded amount exceeds this. Default: 100.
# MAX_PAYMENT_SATS=100

# Cumulative per-participant payout ceiling in sats. Summed from
# lightning_payment_audit over rows with decision='allowed'. Once a
# participant has paid this much across all their calls, further /api/pay
# requests get 403 until the cap is raised. Default: 500.
# MAX_PARTICIPANT_PAYOUT_SATS=500

# ── Housekeeping ─────────────────────────────────────────────────────────────
#
# Background sweeper that deletes `sessions` rows with zero participants
# once they're old enough. A facilitator who creates a session and never
# invites anyone leaves an empty row behind; the SessionNotFound splash on
# stale `?session=…` deep-links is the user-visible side of this cleanup.
#
# Defaults: run every 24h, delete empty sessions older than 24h.
# Set either variable to 0 to disable the pruner entirely.
# SESSION_PRUNE_AGE_HOURS=24
# SESSION_PRUNE_INTERVAL_HOURS=24

# ── Continuous backup (Litestream) ───────────────────────────────────────────
#
# When LITESTREAM_REPLICA_URL is set, the container's entrypoint hands
# control to litestream, which restores from S3 on boot, then supervises
# the backend while streaming WAL changes to S3 every 10s. When unset,
# the container runs the backend directly with no continuous backup
# (fine for local dev; not fine for production).
#
# Typical S3 setup — for R2/B2/MinIO, extend backend/litestream.yml with
# an `endpoint:` field rather than overriding via env.
#
# Don't commit these — set them via `fly secrets set` in production.
# LITESTREAM_REPLICA_URL=s3://your-bucket/bitpilot
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1
